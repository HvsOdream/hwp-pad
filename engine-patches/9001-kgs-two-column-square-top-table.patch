 src/renderer/inline_flow/stored_host.rs       |  4 +-
 src/renderer/layout/square_host_flow.rs       | 24 +++++++++++-
 src/renderer/typeset.rs                       |  2 +-
 src/renderer/typeset/section/flow.rs          | 38 ++++++++++++++++++-
 src/renderer/typeset/state/commands.rs        | 16 ++++++++
 src/renderer/typeset/state/transition.rs      | 15 +++++++-
 7 files changed, 101 insertions(+), 6 deletions(-)

diff --git a/src/renderer/float_placement/stored_square_top_band.rs b/src/renderer/float_placement/stored_square_top_band.rs
index 4766f3603..44b1bad61 100644
--- a/src/renderer/float_placement/stored_square_top_band.rs
+++ b/src/renderer/float_placement/stored_square_top_band.rs
@@ -46,7 +46,13 @@ pub(crate) fn stored_square_top_band(
     let hu = |px| super::super::px_to_hwpunit(px, dpi);
     // 저장 원점의 비교도 원본 HWPUNIT로 한다. 같은 경계의 px 합산 오차를
     // 빈 공간 또는 줄 소유의 차이로 오인하지 않는다.
-    if hu(top) > hu(body.y) || hu(bottom) <= hu(body.y) || line.vertical_pos < hu(bottom - body.y) {
+    // [hwp-pad] 표 위끝이 본문 위끝보다 아래여도 그 틈이 한 줄 높이에 못 미치면 글줄이
+    // 들어갈 수 없으므로 상단을 막는 표다(학회 논문 양식: 쪽 기준 1.0mm 아래의 전폭 제목 표).
+    // 틈에 첫 저장 줄이 들어가는 표는 종전처럼 저장 줄 배치를 유지한다.
+    if hu(top) - hu(body.y) >= line.line_height
+        || hu(bottom) <= hu(body.y)
+        || line.vertical_pos < hu(bottom - body.y)
+    {
         return None;
     }
     let context = FloatPlacementContext::new(*body).with_body_area(*body);
