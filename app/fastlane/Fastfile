# 서일 오피스 — TestFlight 업로드 (GitHub Actions macOS 러너)
# 비밀값(레포 Secrets): ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64, APPLE_TEAM_ID,
#                       MATCH_PASSWORD, MATCH_GIT_BASIC_AUTHORIZATION(base64 "user:PAT", ios-certs 레포 접근용)
default_platform(:ios)

platform :ios do
  desc "빌드해서 TestFlight에 올린다"
  lane :beta do
    app_id = ENV.fetch("APP_ID", "com.hvsodream.seoiloffice")
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )
    setup_ci

    # App ID(개발자 포털)·앱 레코드(App Store Connect)는 2026-11-02 웹에서 직접 만들었다 — 새 앱은 docs/ios-testflight.md 참조

    # 배포용 인증서·프로파일: ios-certs 레포에 암호화 보관, 없으면 API 키로 만든다
    match(type: "appstore", app_identifier: app_id, api_key: api_key, readonly: false)

    profile = ENV["sigh_#{app_id}_appstore_profile-name"]
    update_code_signing_settings(
      path: "ios/App/App.xcodeproj",
      use_automatic_signing: false,
      team_id: ENV.fetch("APPLE_TEAM_ID"),
      targets: ["App"],
      code_sign_identity: "Apple Distribution",
      profile_name: profile,
      bundle_identifier: app_id,
    )
    increment_build_number(build_number: ENV.fetch("BUILD_NUMBER", Time.now.strftime("%Y%m%d%H%M")), xcodeproj: "ios/App/App.xcodeproj")
    increment_version_number(version_number: ENV.fetch("APP_VERSION", "0.1.0"), xcodeproj: "ios/App/App.xcodeproj") rescue nil

    build_app(
      workspace: "ios/App/App.xcworkspace",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "SeoilOffice.ipa",
      export_options: { provisioningProfiles: { app_id => profile } },
    )
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/SeoilOffice.ipa",
      skip_waiting_for_build_processing: true,
      changelog: ENV["CHANGELOG"] || "서일 오피스 테스트 빌드",
    )
  end
end
